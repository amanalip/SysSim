{
  "name": "syssim",
  "version": "1.0.0",
  "description": "Simulate before you scale.",
  "license": "GPL-3.0-only",
  "author": "Aman Ali",
  "repository": {
    "type": "git",
    "url": "https://github.com/amanalip/SysSim.git"
  },
  "engines": {
    "node": ">=20 <23",
    "npm": ">=10"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:accessibility": "vitest run src/__tests__/accessibility-contracts.test.tsx src/__tests__/responsive-and-keyboard-contracts.test.ts",
    "test:performance": "vitest run src/__tests__/event-core-benchmark.test.ts src/__tests__/capacity-calculator-production.test.ts src/__tests__/scalability-benchmark.test.ts src/__tests__/runtime-performance-and-responsiveness.test.ts src/__tests__/render-performance.test.tsx",
    "test:e2e": "playwright test",
    "test:e2e:release": "playwright test --project=chromium --project=firefox --project=webkit",
    "lint": "eslint . --report-unused-disable-directives",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:duplicates": "jscpd src --min-lines 10 --min-tokens 75 --threshold 6 --reporters console,json --output reports/duplication",
    "check:bundle": "npm run build && node scripts/check-bundle-size.mjs",
    "check:security": "npm audit --audit-level=high",
    "check:licenses": "node scripts/check-licenses.mjs",
    "generate:sbom": "node scripts/generate-sbom.mjs",
    "test:scenario-content": "vitest run src/__tests__/scenario-catalog-audit.test.ts",
    "check:scenario-links": "node scripts/check-scenario-links.mjs"
  },
  "dependencies": {
    "@xyflow/react": "^12.4.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.16.0",
    "lz-string": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jscpd": "^5.1.1",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
